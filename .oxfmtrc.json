{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/node_modules/**",
    ".next/**",
    ".agents/**",
    "dist/**",
    "out/**",
    "coverage/**",
    "storybook-static/**",
    "playwright-report/**",
    "test-results/**",
    "blob-report/**",
    "playwright/.auth/**",
    "playwright/.cache/**",
    "docs/performance/**/*.json",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    "@testing-library/jest-dom/vitest"
  ]
}

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "customGroups": [
      {
        "elementNamePattern": ["react", "react/**", "next", "next/**"],
        "groupName": "react_next",
        "selector": "external"
      },
      {
        "elementNamePattern": ["@/shared", "@/shared/**"],
        "groupName": "shared",
        "selector": "internal"
      },
      {
        "elementNamePattern": ["@/domains", "@/domains/**"],
        "groupName": "domains",
        "selector": "internal"
      }
    ],
    "groups": [
      ["value-builtin", "type-builtin"],
      "react_next",
      ["value-external", "type-external", "value-subpath", "type-subpath"],
      "shared",
      "domains",
      ["value-internal", "type-internal"],
      ["value-parent", "type-parent", "value-sibling", "type-sibling", "value-index", "type-index"],
      "side_effect_style",
      "unknown"
    ],
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "ignorePatterns": [
    "src/shared/**",
    "**/node_modules/**",
    ".next/**",
    ".agents/**",
    "dist/**",
    "out/**",
    "coverage/**",
    "storybook-static/**",
    "playwright-report/**",
    "test-results/**",
    "blob-report/**",
    "playwright/.auth/**",
    "playwright/.cache/**",
    "docs/performance/**/*.json",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    "@testing-library/jest-dom/vitest"
  ]
}

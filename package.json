{
  "name": "vehicle-fleet-monitoring-system-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings && pnpm lint:tailwind",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:unused": "knip",
    "check:duplicates": "jscpd src",
    "check:staged": "lint-staged",
    "check:commit": "commitlint",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "check:all": "pnpm check && pnpm check:unused && pnpm check:duplicates",
    "storybook:build": "storybook build",
    "test": "vitest run --project=unit --project=component --project=integration",
    "test:unit": "vitest run --project=unit",
    "test:component": "vitest run --project=component",
    "test:integration": "vitest run --project=integration",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:coverage": "vitest run --coverage --project=unit --project=component --project=integration",
    "test:watch": "vitest",
    "test:unit:watch": "vitest --project unit",
    "test:integration:watch": "vitest --project integration",
    "test:component:watch": "vitest --config vitest.storybook.config.ts",
    "test:e2e": "playwright test --project=\"e2e-*\"",
    "test:e2e:ui": "playwright test --project=\"e2e-*\" --ui",
    "test:e2e:debug": "playwright test --project=\"e2e-*\" --debug",
    "test:e2e:chromium": "playwright test --project=e2e-chromium",
    "test:e2e:firefox": "playwright test --project=e2e-firefox",
    "test:e2e:webkit": "playwright test --project=e2e-webkit",
    "test:e2e:mobile": "playwright test --project=e2e-mobile",
    "test:performance": "playwright test --project=\"performance-*\" --workers=1",
    "test:performance:mobile": "playwright test --project=performance-mobile --workers=1",
    "test:performance:tablet": "playwright test --project=performance-tablet --workers=1",
    "test:performance:desktop": "playwright test --project=performance-desktop --workers=1",
    "test:report": "playwright show-report",
    "test:vitest": "pnpm test && pnpm test:component",
    "test:playwright": "pnpm test:e2e && pnpm test:performance",
    "test:all": "pnpm test:vitest && pnpm test:playwright",
    "test:storybook:watch": "vitest --config vitest.storybook.config.ts",
    "storybook": "storybook dev -p 6006",
    "lint:tailwind": "node scripts/check-tailwind-classes.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.107.1",
    "cn": "^0.5.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "latest",
    "postcss": "^8.5.33",
    "storybook": "^10.6.7",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "pnpm@12.18.0"
}
